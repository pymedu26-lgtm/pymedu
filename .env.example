# ============================================
# PymEdu - Variables de Entorno (Ejemplo)
# ============================================

# Frontend (Vite). En Railway el SPA y la API comparten origen, por lo que
# puede dejarse vacío. Solo hace falta en desarrollo con proxies distintos.
VITE_API_URL=

# Backend API
API_PORT=3001

# Base de datos.
# - MODO LOCAL (pruebas sin Railway): deja DATABASE_URL vacía o usa DB_MODE=local.
#   La API usa PGlite (PostgreSQL embebido) en server/.data/pglite y carga datos demo.
# - RAILWAY: pega aquí la URL (Railway > tu proyecto > Variables) y quita DB_MODE.
DB_MODE=local
# DATABASE_URL="postgresql://postgres:tu_password@tu-host.railway.app:5432/railway?sslmode=require"
# En modo local los datos demo vienen activados; SEED_DEMO=0 los desactiva. En Railway, SEED_DEMO=1 los activa.
# SEED_DEMO=1
# Secreto compartido para POST /api/mentorias/eventos (webhooks internos entre apps).
EVENTOS_SECRET=cambia-esto
# Correo de Mentorías (Resend). Sin clave, los correos solo se registran en consola.
# RESEND_API_KEY=
# Frontend: VITE_TBK_ENV=produccion quita los avisos de "Modo prueba"; VITE_DEMO=1 muestra las cuentas demo fuera de desarrollo.
# VITE_TBK_ENV=integracion
# VITE_DEMO=1

# Secreto para firmar los tokens JWT de sesion (obligatorio cambiar en prod).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo"

# Si se levanta la API en desarrollo separada del SPA, usar el puerto que quieras.
PORT=4000

# URL publica del frontend (para enlaces y redireccion tras pagar)
FRONT_URL=https://tu-dominio.railway.app

# ============================================
# Transbank Webpay Plus (pagos de suscripcion)
# https://www.transbankdevelopers.cl/referencia/webpay
# Por defecto usa el AMBIENTE DE INTEGRACION (tarjetas de prueba).
# ============================================
TBK_ENV=integracion
TBK_COMERCIO_CODIGO=597055555532
TBK_API_KEY_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1

# URL publica de esta API (recibe el retorno POST de Transbank)
API_PUBLIC_URL=https://pymedu-api.up.railway.app
